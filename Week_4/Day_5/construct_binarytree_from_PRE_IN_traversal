class Solution {

    int index = 0;

    public TreeNode buildTree(int[] preorder, int[] inorder) {
        return solve(preorder, inorder, 0, inorder.length - 1);
    }

    TreeNode solve(int[] preorder, int[] inorder, int start, int end) {

        if(start > end) {
            return null;
        }

        int value = preorder[index++];

        TreeNode root = new TreeNode(value);

        int pos = start;

        while(inorder[pos] != value) {
            pos++;
        }

        root.left = solve(preorder, inorder, start, pos - 1);
        root.right = solve(preorder, inorder, pos + 1, end);

        return root;
    }
}